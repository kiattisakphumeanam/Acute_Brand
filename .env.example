# Copy to .env.local and fill in. Without these, the site runs on mock data and checkout is disabled.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Developers → API keys / Webhooks)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Google Sheet for membership sign-ups (see scripts/membership-sheet.gs). Leave empty to skip the sheet.
MEMBERSHIP_SHEET_URL=
MEMBERSHIP_SHEET_SECRET=
